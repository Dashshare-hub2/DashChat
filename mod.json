{
	"geode": "5.9.0",
	"gd": {
    "mac": "2.2081",
    "ios": "2.2081",
    "android": "2.2081"
  },
	"id": "daianhnguyen.dashchat",
	"name": "DashChat",
	"version": "v1.0.0",
	"developer": "daianhnguyen",
	"description": "Global Realtime Chat Mod for Geometry Dash",
	"settings": {
    "server-url": {
      "name": "Server WebSocket URL",
      "type": "string",
      "default": "wss://dashchat-rsuk.onrender.com"
    },
    "user-token": {
      "name": "User Session Token",
      "type": "string",
      "default": ""
    }
  },
  "keybinds": [
    {
      "id": "toggle-chat",
      "name": "Toggle Chat Overlay",
      "description": "Press to toggle chat input box",
      "default": "Tab"
    }
  ]
	}